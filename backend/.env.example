# Copy to .env and fill in real values. See deployment.md for how to
# generate every key below and where each one gets set in Azure.

ENV=development

# --- LLM providers ---
# Gemini (Google AI Studio) — summarizer, embeddings, and (by default) the judge
GEMINI_API_KEY=AIza...
# Optional cross-family judge on any OpenAI-compatible provider (Groq/OpenRouter/
# OpenAI). Leave blank for the all-Gemini default; if set, point JUDGE_MODEL at it.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Source-discovery web search (Serper is the default provider) ---
SERPER_API_KEY=...
# BRAVE_SEARCH_API_KEY=   # optional: if set, Brave is primary with Serper as fallback

# --- Persistence (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:...@db.....supabase.co:5432/postgres
SUPABASE_URL=https://....supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auth ---
CLERK_SECRET_KEY=sk_...
# Local dev only: set AUTH_DISABLED=true to skip Clerk JWT checks (ignored when
# ENV=production). Lets you run the API before Clerk is configured.
AUTH_DISABLED=false

# --- CORS: the deployed frontend origin ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Model selection (defaults shown; override only if you want to swap models) ---
SUMMARIZER_MODEL=gemini-pro-latest
SUMMARIZER_FALLBACK_MODEL=gemini-flash-latest
JUDGE_MODEL=gemini-flash-latest
JUDGE_FALLBACK_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
