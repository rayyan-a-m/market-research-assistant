# Copy to .env.local and fill in real values. See deployment.md for how to
# generate the Clerk keys and where each is set in Vercel.

# Base URL of the FastAPI backend (Azure Container Apps in prod)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Clerk ---
# Sign-in methods (Google OAuth + one-time email code) are enabled in the
# Clerk dashboard, not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect config. NEXT_PUBLIC_CLERK_SIGN_IN_URL is not optional in a
# deployed environment: without it Clerk sends users to its own hosted
# accounts.dev page instead of the app's /sign-in route. Set all three in
# Vercel too, not just locally.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
